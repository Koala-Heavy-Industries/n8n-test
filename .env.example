# cp .env.example .env して値を埋める。.env はコミットしない。
#
# 秘密値の生成例:
#   openssl rand -hex 32     (N8N_ENCRYPTION_KEY)
#   openssl rand -base64 24  (各パスワード)

# ---------- compose(必須) ----------
# n8n の credential 復号鍵。失うと全 credential が復元できず、
# 漏洩すると全 credential が復号される。DB とは別の場所にバックアップする。
N8N_ENCRYPTION_KEY=
N8N_DB_PASSWORD=

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_DB_PASSWORD=

TZ=Asia/Tokyo
# Webhook の外部到達 URL。GitHub からのマージ通知を受ける場合は
# トンネル(smee.io / cloudflared 等)の URL を入れる。
# 届かなくても日次リコンサイルで収束するため、まずは localhost でよい。
WEBHOOK_URL=http://localhost:5678/

# ---------- 以下はワークフロー側の設定値(n8n の変数 / Credential に入れる) ----------
# compose では使わない。実装時の置き換え対象の一覧として記載する。
# 設計: docs/design/05-environment.md

# 台帳・GitHub
LEDGER_REPO=Koala-Heavy-Industries/khi-ledger
GITHUB_ORG=Koala-Heavy-Industries

# Keycloak(コンテナ間は http://keycloak:8080)
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=khi-dev

# 宛先(検証中は Mailpit で受ける。SMTP は smtp://mailpit:1025)
APPROVER_EMAILS=approver@example.com
ADMIN_EMAILS=it-admin@example.com
LICENSE_ASSIGNEE=license@example.com

# リマインド・安全装置
REMIND_INTERVAL_DAYS=3
REMIND_MAX=3
REVOKE_CIRCUIT_BREAKER=5
HEARTBEAT_URL=

# NetBox / ハイパーバイザー(第6・7段階で使用)
NETBOX_URL=http://netbox:8000
