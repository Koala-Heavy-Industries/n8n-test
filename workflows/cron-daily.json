{
  "id": "crondaily0000001",
  "name": "cron-daily",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "31000000-0000-4000-8000-000000000001",
      "name": "毎日9時",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// 日次のバックストップ。\n// 1. reconcile: 台帳と実サービスの差分を収束させる(Webhook の取りこぼし対策、\n//    失敗の再試行、日付起点の予約発効を兼ねる)\n// 2. remind-scheduler: 未完了タスクのリマインドとエスカレーション\n// 設計: docs/design/01-member-lifecycle.md / 04-notification-abstraction.md\nreturn [{ json: {} }];"
      },
      "id": "31000000-0000-4000-8000-000000000002",
      "name": "開始",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "reconcile0000001",
          "mode": "id"
        },
        "mode": "each",
        "options": {}
      },
      "id": "31000000-0000-4000-8000-000000000003",
      "name": "reconcile",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        440,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// reconcile の結果は握りつぶさず、次段へ渡す前に整形する。\nreturn [{ json: { reconcile: $input.first()?.json ?? null } }];"
      },
      "id": "31000000-0000-4000-8000-000000000004",
      "name": "結果を保持",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "workflowId": {
          "__rl": true,
          "value": "remindsched00001",
          "mode": "id"
        },
        "mode": "each",
        "options": {}
      },
      "id": "31000000-0000-4000-8000-000000000005",
      "name": "remind-scheduler",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [
        880,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{ json: {\n  reconcile: $('結果を保持').first().json.reconcile,\n  remind: $input.first()?.json ?? null,\n  ranAt: new Date().toISOString(),\n}}];"
      },
      "id": "31000000-0000-4000-8000-000000000006",
      "name": "サマリ",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ]
    }
  ],
  "connections": {
    "毎日9時": {
      "main": [
        [
          {
            "node": "開始",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "開始": {
      "main": [
        [
          {
            "node": "reconcile",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "reconcile": {
      "main": [
        [
          {
            "node": "結果を保持",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "結果を保持": {
      "main": [
        [
          {
            "node": "remind-scheduler",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "remind-scheduler": {
      "main": [
        [
          {
            "node": "サマリ",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "executionTimeout": 1800
  }
}
