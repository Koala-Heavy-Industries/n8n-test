{
  "id": "ledgerdelete0001",
  "name": "ledger-delete",
  "nodes": [
    {
      "parameters": {},
      "id": "81000000-0000-4000-8000-000000000001",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [-240, 0]
    },
    {
      "parameters": {
        "jsCode": "// 入力: { kind: 'members'|'pcs'|'servers', id, reason? }\n// 出力: { ok, path, existed }\n//\n// 主な用途は「資産管理番号が仮から正式に変わったときの旧ファイルの削除」。\n// 履歴は git に残るため、ファイル自体は消してよい。\n// 設計: docs/design/02-pc-register.md(同定キーの変更)\n\nconst inp = $input.first()?.json ?? {};\nconst DIRS = { members: 'state/members', pcs: 'state/pcs', servers: 'state/servers' };\nconst dir = DIRS[inp.kind];\nif (!dir) throw new Error(`ledger-delete: 不正な kind: ${JSON.stringify(inp.kind)}`);\nif (!inp.id || !/^[A-Za-z0-9][A-Za-z0-9._-]*$/.test(String(inp.id))) {\n  throw new Error(`ledger-delete: id が不正です: ${inp.id}`);\n}\n\nconst repo = $env.LEDGER_REPO;\nconst path = `${dir}/${inp.id}.yaml`;\nreturn [{ json: {\n  path,\n  url: `https://api.github.com/repos/${repo}/contents/${path}`,\n  message: `state(${inp.kind}): ${inp.id} を削除` + (inp.reason ? ` — ${inp.reason}` : ''),\n}}];"
      },
      "id": "81000000-0000-4000-8000-000000000002",
      "name": "削除対象を決める",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 0]
    },
    {
      "parameters": {
        "url": "={{ $json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "81000000-0000-4000-8000-000000000003",
      "name": "現在の内容を取得",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 0],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
      "credentials": { "httpHeaderAuth": { "id": "github-ledger", "name": "GitHub (khi-ledger)" } }
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose", "version": 2 },
          "conditions": [
            { "id": "exists", "leftValue": "={{ $json.sha ? 'yes' : 'no' }}", "rightValue": "yes",
              "operator": { "type": "string", "operation": "equals" } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "81000000-0000-4000-8000-000000000004",
      "name": "ファイルがあるか",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [420, 0]
    },
    {
      "parameters": {
        "method": "DELETE",
        "url": "={{ $('削除対象を決める').first().json.url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ message: $('削除対象を決める').first().json.message, sha: $json.sha }) }}",
        "options": {}
      },
      "id": "81000000-0000-4000-8000-000000000005",
      "name": "削除する",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, -100],
      "credentials": { "httpHeaderAuth": { "id": "github-ledger", "name": "GitHub (khi-ledger)" } }
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('削除対象を決める').first().json;\nreturn [{ json: { ok: true, path: ctx.path, existed: true } }];"
      },
      "id": "81000000-0000-4000-8000-000000000006",
      "name": "削除できた",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, -100]
    },
    {
      "parameters": {
        "jsCode": "// 既に無い場合も成功として返す(冪等)。\nconst ctx = $('削除対象を決める').first().json;\nreturn [{ json: { ok: true, path: ctx.path, existed: false } }];"
      },
      "id": "81000000-0000-4000-8000-000000000007",
      "name": "既に無い",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 120]
    }
  ],
  "connections": {
    "When Executed by Another Workflow": { "main": [[{ "node": "削除対象を決める", "type": "main", "index": 0 }]] },
    "削除対象を決める": { "main": [[{ "node": "現在の内容を取得", "type": "main", "index": 0 }]] },
    "現在の内容を取得": { "main": [[{ "node": "ファイルがあるか", "type": "main", "index": 0 }]] },
    "ファイルがあるか": {
      "main": [
        [{ "node": "削除する", "type": "main", "index": 0 }],
        [{ "node": "既に無い", "type": "main", "index": 0 }]
      ]
    },
    "削除する": { "main": [[{ "node": "削除できた", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
